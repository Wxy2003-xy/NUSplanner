{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM"],
    "jsx": "react-jsx",
    "baseUrl": "./website/src",  // Adjusted to point directly where your source files are
    "paths": {
      "@/*": ["*"]  // Simplified based on the new baseUrl
    },
    "moduleResolution": "node",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["jest"],
    "allowSyntheticDefaultImports": true,
    "noUnusedLocals": false, // Set this to false to ignore local unused variables
    "noUnusedParameters": false
  },
  "include": [
    "**/*",  // To include all files under the src directory
    "../test/**/*"  // Assuming test directory is at the same level as src
  ],
  "exclude": ["node_modules", "build"],
  "references": [
    { "path": "./tsconfig.node.json" }
  ]
}

 