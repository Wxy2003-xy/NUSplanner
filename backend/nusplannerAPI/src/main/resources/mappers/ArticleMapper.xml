<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.tedu.nusplannerapi.mapper.ArticleMapper">
    <select id="selectArticle" resultType="cn.tedu.nusplannerapi.pojo.vo.ArticleVO">
        SELECT id,title,content, thumbsup, dislike FROM article
    </select>

    <insert id="insert">
        INSERT INTO article(title,content,created_Time)
        VALUES(#{title},#{content},#{createTime})
    </insert>

    <update id="updateLike">
        UPDATE article
        SET thumbsup = thumbsup + 1
        where id=#{id}
    </update>

    <update id="updatedislike">
        UPDATE article
        SET dislike = dislike + 1
        where id=#{id}
    </update>
</mapper>